# Vzor pro /etc/fxlive.env
#
# Zkopiruj, vypln a nastav prava tak, aby to precetl jen root:
#
#   sudo install -m 600 -o root -g root fxlive.env.example /etc/fxlive.env
#   sudo nano /etc/fxlive.env
#
# TENHLE SOUBOR (vzor) do gitu patri. Vyplneny /etc/fxlive.env NIKDY.

# Token z uctu: Manage API Access -> Generate.
OANDA_TOKEN=sem-vloz-token

# ID uctu. Zacina 101 = demo, 001 = ostry ucet.
OANDA_ACCOUNT=101-004-1234567-001
